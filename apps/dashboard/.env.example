# ⚠️ SECURITY WARNING: Environment Variable Exposure
# ========================================================
# Any variable prefixed with NEXT_PUBLIC_ is exposed to the browser!
# NEVER prefix API keys, secrets, or credentials with NEXT_PUBLIC_
#
# Safe for NEXT_PUBLIC_:
#   - Public API endpoints (NEXT_PUBLIC_API_BASE_URL)
#   - Firebase client config (public identifiers, not secrets)
#   - Feature flags
#   - Analytics IDs
#
# NEVER use NEXT_PUBLIC_ for:
#   - API keys or secrets
#   - Database credentials
#   - Private tokens
#   - Admin passwords
# ========================================================

# Firebase Auth client config (from Firebase Console > Project Settings).
# Safe to expose to the browser — these are public client identifiers, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Where the dashboard reaches the API.
# Safe to expose - this is a public endpoint URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Optional — enables the Dev Dashboard's Monitoring/Logs pages (links to a
# real Grafana instance instead of reinventing charts/log search). Leave
# blank to just show setup instructions on those pages instead.
NEXT_PUBLIC_GRAFANA_URL=

# Optional — dev-only "Mail Server Administration" link on the SMTP page,
# points at your Postal (or other mail server) admin panel. Leave blank to
# hide the link with instructions instead.
NEXT_PUBLIC_POSTAL_ADMIN_URL=
