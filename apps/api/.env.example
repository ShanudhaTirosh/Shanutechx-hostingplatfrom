# SHANUTECHX API Environment Variables

# Server Port
PORT=4000

# Database Connection (PostgreSQL)
# Connection pooling configuration:
# - connection_limit: Max connections per instance (default: 10-20 recommended)
# - pool_timeout: How long to wait for connection (default: 10 seconds)
# - connection_timeout: TCP connection timeout (default: 5 seconds)
DATABASE_URL="postgresql://user:password@localhost:5432/shanutechx?schema=public&connection_limit=20&pool_timeout=10&connection_timeout=5"

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID="shanutechx"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@shanutechx.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL="https://shanutechx.firebaseio.com"

# External Integrations
WHATSAPP_INTERNAL_SECRET="your-whatsapp-internal-secret"
WHATSAPP_BOT_URL="http://localhost:4100"
DISCORD_INTERNAL_SECRET="your-discord-internal-secret"
DISCORD_BOT_URL="http://localhost:4200"

# Cloudflare DNS Integration
# CLOUDFLARE_API_TOKEN: API token with DNS:Edit and SSL/TLS:Edit permissions
# CLOUDFLARE_ZONE_ID: Zone ID for the platform domain (found in Cloudflare dashboard)
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"
ROOT_DOMAIN="shanutechx.com"

# Infrastructure & Node Agent Communications
NODE_AGENT_SECRET="your-node-agent-secret"
NODE_AGENT_PORT=5000

# Traefik Configuration (Optional - currently managed via Docker labels)
# TRAEFIK_CONFIG_PATH="/path/to/traefik/dynamic/config"

# AI / Vision Extraction (Gemini / Groq)

# DEPRECATED — the delayed auto-verify job this used to configure was
# removed along with the AI auto-approval path above. Not read anywhere.
AUTO_VERIFY_DELAY_MS=86400000

# Subscription Grace Period (days before past_due subscriptions are cancelled)
# Default: 7 days. Increase for premium customers, decrease for free tier.
# Examples: 3 (aggressive), 7 (default), 14 (lenient), 30 (enterprise)
GRACE_PERIOD_DAYS=7

# Webhooks & Security
SMS_WEBHOOK_SECRET="your-sms-webhook-secret"
SECRETS_ENCRYPTION_KEY="32-byte-hex-secret-for-encrypting-credentials"
# Signs JWTs for the Auth-as-a-Service feature (per-project end-user auth) —
# deliberately separate from SECRETS_ENCRYPTION_KEY so a leak here can't be
# used to decrypt stored credentials, only to forge project-auth tokens.
PROJECT_AUTH_JWT_SECRET="another-long-random-secret-distinct-from-the-one-above"
BILLING_CRON_SECRET="your-billing-cron-secret"

# WildDuck Mail Server REST API
WILDDUCK_API_URL="http://localhost:8080"
WILDDUCK_API_KEY="secret-wildduck-api-token"

# Redis Connection (BullMQ queues & rate limiting)
REDIS_URL="redis://localhost:6379"

# Leaseweb Integration (Optional)
LEASEWEB_API_KEY=""

# Cloudflare R2 Backups (Optional)
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ENDPOINT=""
R2_BUCKET_NAME="shanutechx-backups"

# SSL Certificate Renewal Configuration
# SSL_RENEWAL_CHECK_INTERVAL_HOURS: How often to check for certificate expiration (default: 24 hours)
# The renewal job runs daily at midnight to check all SSL certificates and renew those expiring within 7 days
SSL_RENEWAL_CHECK_INTERVAL_HOURS=24

# Optional — Traefik's REST API (Dev Dashboard -> Reverse Proxy page).
# Defaults to http://traefik:8080, the internal Docker service name from
# infra/control-plane/docker-compose.yml. Only override if Traefik lives
# somewhere else reachable from wherever this API server runs.
# TRAEFIK_API_URL=http://traefik:8080

# ── Git repository access: GitHub App + GitLab OAuth application ──────────
# Uses GitHub App + GitLab OAuth application — no PATs are requested from or stored for
# users. Both are optional: if unset, GET /api/git/config reports the
# provider as "not configured" and the dashboard hides its connect button,
# rather than the app failing to boot.

# GitHub App — create one at https://github.com/settings/apps/new
GITHUB_APP_ID=""
GITHUB_APP_SLUG=""
# PEM private key downloaded from the App's settings page. Escape
# newlines as \n if pasting inline, same as FIREBASE_PRIVATE_KEY above.
GITHUB_APP_PRIVATE_KEY=""
# Webhook secret configured on the App, if you wire up push-event webhooks.
GITHUB_APP_WEBHOOK_SECRET=""

# GitLab OAuth application — create one at
# https://gitlab.com/-/user_settings/applications (or your GitLab
# instance's equivalent). Redirect URI must exactly match
# GITLAB_REDIRECT_URI below (defaults to
# https://api.<ROOT_DOMAIN>/api/git/gitlab/callback).
GITLAB_APP_CLIENT_ID=""
GITLAB_APP_CLIENT_SECRET=""
# GITLAB_REDIRECT_URI="https://api.shanutechx.com/api/git/gitlab/callback"

# Signs the short-lived `state` parameter used across both the GitHub App
# install redirect and the GitLab OAuth authorize redirect (prevents
# account-linking CSRF). Defaults to PROJECT_AUTH_JWT_SECRET if unset, but
# a dedicated value is recommended.
# GIT_OAUTH_STATE_SECRET=""

# Where to redirect the browser back to after connecting an account
# (defaults to https://app.<ROOT_DOMAIN>).
# DASHBOARD_URL="https://app.shanutechx.com"

# ── Docker Compose networking note ─────────────────────────────────────────
# WHATSAPP_BOT_URL / DISCORD_BOT_URL above default to http://localhost:...
# which is correct ONLY when running every service directly on the host.
# When running via docker-compose.local.yml, these must instead point at
# the Compose service names so cross-container requests resolve:
#   WHATSAPP_BOT_URL="http://whatsapp-bot:4100"
#   DISCORD_BOT_URL="http://discord-bot:4200"

# ── All-in-one first-run deployment (Supabase + Postal + MinIO) ──────────
# If you're running the FULL stack via `docker-compose.local.yml`
# (control plane + self-hosted Supabase + self-hosted Postal mail +
# MinIO object storage all together), you do NOT need to fill in
# SUPABASE_KONG_URL / SUPABASE_META_URL / SUPABASE_STUDIO_URL /
# POSTAL_API_URL / R2_ENDPOINT / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY
# here — docker-compose.local.yml's `api`/`worker` services already
# inject those, pointed at the in-stack services, overriding whatever is
# in this file. What you DO still need to fill in here (or better, in the
# repo-root .env.example -> .env, which is where Compose reads them from
# for first-run substitution):
#   - SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY (see
#     infra/supabase/generate-keys.js)
#   - POSTAL_API_KEY (only obtainable after first boot — see
#     infra/postal/postal.yml's setup comment)
# This file (apps/api/.env) is what matters if you're running the API
# OUTSIDE Docker Compose, or against real external Supabase/Postal/R2
# instances instead of the in-stack ones — set the real values above in
# that case.
