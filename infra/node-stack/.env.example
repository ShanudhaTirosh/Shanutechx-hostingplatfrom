# Node Stack Environment Configuration
# Deployed on each worker VPS hosting customer applications.

ROOT_DOMAIN=shanutechx.com
ACME_EMAIL=admin@shanutechx.com

# Must match the NODE_AGENT_SECRET configured in the control-plane API
NODE_AGENT_SECRET=change-me-to-secure-shared-secret

# Main control plane API URL (used for reporting node status)
API_URL=https://api.shanutechx.com
