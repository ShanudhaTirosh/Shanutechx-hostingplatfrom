ROOT_DOMAIN=shanutechx.com
ACME_EMAIL=admin@shanutechx.com
POSTGRES_PASSWORD=change-me-to-a-secure-postgres-password
GRAFANA_ADMIN_PASSWORD=change-me-to-a-secure-grafana-password

# Only needed if this VPS also runs the optional node-agent service (i.e.
# it's registered as a hosting Node, not just the control plane).
# Must match the value the main API uses when calling this node.
NODE_AGENT_SECRET=change-me-to-a-secure-secret

# Dashboard build args — NEXT_PUBLIC_* vars get baked into the client bundle
# at `docker compose build` time, so they live here rather than in
# apps/dashboard/.env (which only affects container runtime, too late for
# these). Same values as apps/dashboard/.env.example.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_API_BASE_URL=https://api.shanutechx.com

# ── Object storage (MinIO — self-hosted S3-compatible) ─────────────────────
# Backs DB backups/uploads AND Supabase Storage. Change these before going
# live — see the api service's comment in docker-compose.yml for how to
# swap this for real Cloudflare R2 instead.
MINIO_ROOT_USER=shanutechx_minio
MINIO_ROOT_PASSWORD=change-me-to-a-secure-minio-password

# ── Self-hosted Supabase ─────────────────────────────────────────────────
# Generate with: node infra/supabase/generate-keys.js (run from repo root)
JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=change-me-to-a-secure-supabase-db-password
SUPABASE_REALTIME_SECRET=change-me-to-a-random-string-at-least-64-chars-long
SUPAVISOR_VAULT_ENC_KEY=
FUNCTIONS_VERIFY_JWT=false

# ── Self-hosted Mail (WildDuck Mail Server) ──────────────────────────────
WILDDUCK_API_KEY=change-me-to-a-secure-wildduck-api-key
WILDDUCK_FROM_ADDRESS=no-reply@shanutechx.com

