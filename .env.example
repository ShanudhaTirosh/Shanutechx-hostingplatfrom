# ── ShanuTechX Root Environment Variables Template (.env.example) ─────────────
# Copy this file to `.env` at the root directory before running.

# ── 1. System Domain & Networking ───────────────────────────────────────────
ROOT_DOMAIN=shanutechx.com
API_BASE_URL=https://api.shanutechx.com
ACME_EMAIL=admin@shanutechx.com
PORT=4000
NODE_ENV=development

# ── 2. Core REST API & Security Secrets ──────────────────────────────────────
SECRETS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PROJECT_AUTH_JWT_SECRET=CHANGE_ME_project_auth_jwt_secret_at_least_64_chars_long
NODE_AGENT_SECRET=CHANGE_ME_shared_secret_between_api_and_node_agents
NODE_AGENT_PORT=5000
BILLING_CRON_SECRET=CHANGE_ME_billing_cron_secret_for_daily_jobs
SMS_WEBHOOK_SECRET=CHANGE_ME_sms_webhook_ingest_secret

# ── 3. Database Credentials ─────────────────────────────────────────────────
POSTGRES_USER=shanutechx
POSTGRES_PASSWORD=CHANGE_ME_secure_postgres_pass
POSTGRES_DB=shanutechx
DATABASE_URL="postgresql://shanutechx:CHANGE_ME_secure_postgres_pass@localhost:5432/shanutechx?schema=public"
REDIS_URL="redis://localhost:6379"

# ── 4. Firebase Admin SDK & Realtime Database ────────────────────────────────
FIREBASE_PROJECT_ID=shanutechx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@shanutechx.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME_YOUR_FIREBASE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://shanutechx-default-rtdb.firebaseio.com

# ── 5. Cloudflare DNS Integration ───────────────────────────────────────────
CLOUDFLARE_API_TOKEN=your-cf-zone-dns-token
CLOUDFLARE_ZONE_ID=your-cf-zone-id

# ── 6. Cloudflare R2 / S3 Object Storage ─────────────────────────────────────
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET_NAME=shanutechx-backups

# ── 7. Multi-Channel Messaging Gateways & Internal Secrets ──────────────────
DISCORD_BOT_URL=http://localhost:4200
DISCORD_INTERNAL_SECRET=CHANGE_ME_discord_secret
WHATSAPP_BOT_URL=http://localhost:4100
WHATSAPP_INTERNAL_SECRET=CHANGE_ME_whatsapp_secret

# ── 8. WildDuck Mail Server & Webmail Credentials ─────────────────────────────
WILDDUCK_API_URL=http://localhost:8080
WILDDUCK_API_KEY=your-wildduck-api-key
WILDDUCK_FROM_ADDRESS=no-reply@shanutechx.com

# ── 9. Git Integrations & Shadow Backups (Optional) ───────────────────────────
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_ORG=shanutechx-deploy-backups

# ── 10. Dashboard Web Client Firebase Public Credentials ─────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shanutechx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shanutechx
