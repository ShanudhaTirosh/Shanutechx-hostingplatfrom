# ── ShanuTechX Root Environment Variables Template (.env.example) ─────────────
# Copy this file to `.env` at the root directory before running:
#   - Local Dev:   docker compose -f docker-compose.local.yml up -d
#   - Production:  docker compose -f docker-compose.prod.yml up -d

# ── 1. System Domain & Networking ───────────────────────────────────────────
ROOT_DOMAIN=shanutechx.com
API_BASE_URL=https://api.shanutechx.com
ACME_EMAIL=admin@shanutechx.com

# ── 2. Core REST API & Security Secrets ──────────────────────────────────────
PORT=4000
NODE_ENV=production
JWT_SECRET=CHANGE_ME_long_random_jwt_secret_at_least_64_chars_long
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
NODE_AGENT_SECRET=CHANGE_ME_shared_secret_between_api_and_node_agents

# ── 3. Database Credentials ─────────────────────────────────────────────────
POSTGRES_USER=shanutechx
POSTGRES_PASSWORD=CHANGE_ME_secure_postgres_pass
POSTGRES_DB=shanutechx
DATABASE_URL="postgresql://shanutechx:CHANGE_ME_secure_postgres_pass@postgres:5432/shanutechx?schema=public"

# ── 4. Cloudflare R2 Free Storage (10 GB Free Storage) ─────────────────────
# Point to real Cloudflare R2 or self-hosted MinIO:
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-cloudflare-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-cloudflare-r2-secret-access-key
R2_BUCKET_NAME=shanutechx-backups

# ── 5. Free Cloud Webhook Backup Target ─────────────────────────────────────
# Free Google Apps Script / Supabase / Firebase webhook URL:
FREE_BACKUP_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx.../exec

# ── 6. Self-Hosted Supabase Studio & BaaS ────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
SUPABASE_URL=http://localhost:8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SUPABASE_KONG_URL=http://localhost:8000
SUPABASE_META_URL=http://localhost:8080
SUPABASE_GOTRUE_URL=http://localhost:9999
SUPABASE_REST_URL=http://localhost:3000
SUPABASE_STORAGE_URL=http://localhost:5000
SUPABASE_GRAPHQL_URL=http://localhost:8000/graphql/v1
SUPABASE_STUDIO_PORT=3003
SUPABASE_ANON_KEY=your-supabase-anon-key-hs256-jwt
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-hs256-jwt
SUPABASE_PUBLISHABLE_KEY=sb_publishable_v1_live_key_shanutechx_001
SUPABASE_SECRET_KEY=sb_secret_v1_live_key_shanutechx_admin_001
SUPABASE_DB_PASSWORD=CHANGE_ME_supabase_db_pass
SUPABASE_REALTIME_SECRET=CHANGE_ME_realtime_secret_at_least_64_chars_long


# ── 7. Cloudflare API Token (Zone:DNS Edit) ─────────────────────────────────
CLOUDFLARE_API_TOKEN=your-cf-zone-dns-token

# ── 8. Multi-Channel Bots & Push Notifications ─────────────────────────────
DISCORD_BOT_URL=http://localhost:5005
DISCORD_INTERNAL_SECRET=CHANGE_ME_discord_secret
WHATSAPP_BOT_URL=http://localhost:5006
WHATSAPP_INTERNAL_SECRET=CHANGE_ME_whatsapp_secret

# ── 9. Self-Hosted Postal SMTP ──────────────────────────────────
POSTAL_DB_ROOT_PASSWORD=CHANGE_ME_postal_db_root_pass
POSTAL_API_KEY=your-postal-api-key
POSTAL_FROM_ADDRESS=no-reply@shanutechx.com

# ── 10. Dashboard Firebase Web Config ───────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=shanutechx.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=shanutechx
