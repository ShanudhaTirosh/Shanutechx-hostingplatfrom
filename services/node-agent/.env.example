AGENT_PORT=5000

# Must match the value the main API uses for this node (Node.sshKeyRef points
# at where the real secret lives in your vault — this env var is the actual
# value on the node itself).
NODE_AGENT_SECRET=

ROOT_DOMAIN=shanutechx.com
AGENT_PUBLIC_NETWORK=shanutechx-public
AGENT_WORKSPACES_DIR=/var/lib/shanutechx/workspaces

# Only relevant on nodes that also run a self-hosted LiveKit server.
LIVEKIT_CONFIG_FILE=/etc/livekit/livekit.yaml
LIVEKIT_CONTAINER_NAME=livekit-server
