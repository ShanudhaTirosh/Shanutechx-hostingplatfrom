DISCORD_PORT=4200

# From the Discord Developer Portal (https://discord.com/developers/applications)
# > your app > Bot > Token.
DISCORD_BOT_TOKEN=

# Channel ID where order/payment/node alerts get posted. Right-click a
# channel in Discord (with Developer Mode enabled) > Copy Channel ID.
ADMIN_ALERT_CHANNEL_ID=

# Must match the value the main API uses for this service.
DISCORD_INTERNAL_SECRET=
