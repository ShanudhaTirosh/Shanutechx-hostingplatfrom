# ShanuTechX Discord Bot Configuration

DISCORD_PORT=4200
LOG_LEVEL=info

# Discord Bot Credentials from Discord Developer Portal
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=your_discord_guild_id_here

# Channel & Role IDs
ADMIN_ALERT_CHANNEL_ID=your_admin_alert_channel_id_here
DISCORD_STAFF_ROLE_ID=your_staff_role_id_here
DISCORD_ANNOUNCEMENT_CHANNEL_ID=your_announcement_channel_id_here
DISCORD_LOG_CHANNEL_ID=your_log_channel_id_here

# Role & User Whitelists for Admin/Staff Commands (comma-separated IDs or names)
ALLOWED_DISCORD_ROLES=Staff,Admin,Superuser
ALLOWED_DISCORD_USERS=123456789012345678

# Internal Communication Gate with ShanuTechX Core API
DISCORD_INTERNAL_SECRET=dev-secret-change-in-production
API_INTERNAL_URL=http://localhost:4000
ROOT_DOMAIN=shanutechx.com
