# ShanuTechX WhatsApp Bot Configuration

WHATSAPP_PORT=4100
LOG_LEVEL=info

# Internal Communication Gate with ShanuTechX Core API
WHATSAPP_INTERNAL_SECRET=dev-secret-change-in-production
API_INTERNAL_URL=http://localhost:4000
ROOT_DOMAIN=shanutechx.com

# NOTE: staff commands (!claim, !close, !broadcast, ...) are authorised by the user's role
# (admin/dev/support) in the platform database, matched by their phone number. There is no
# ADMIN_PHONE_NUMBERS setting.
