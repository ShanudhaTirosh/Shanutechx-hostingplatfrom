# ShanuTechX Supabase Environment Variables
#
# REQUIRED: generate real values with `node infra/supabase/generate-keys.js`
# (run from the repo root) and paste its full output here — it prints
# both the SUPABASE_-prefixed names (for apps/api/.env / the root .env)
# and the plain names this file uses (ANON_KEY / SERVICE_ROLE_KEY /
# JWT_SECRET), which must be the SAME values in both places.
#
# SECURITY: this file previously shipped Supabase's own well-known public
# demo JWT keys (the ones with "iss": "supabase-demo", used in thousands
# of tutorials) as the literal example values, next to an equally generic
# default JWT_SECRET. If you ever deployed this without changing them,
# treat those as burned — anyone can forge a valid service_role token for
# a JWT_SECRET this well-known. Generate fresh ones before going anywhere
# near real data.
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

POSTGRES_PASSWORD=shanutechx_super_secret_postgres_pass_2026
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5435

# Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in the repo-root .env
# (docker-compose.local.yml's minio service) — the `storage` service in
# this stack now uses that same MinIO instance as its S3 backend (fixed:
# previously used unpersisted container-local disk).
MINIO_ROOT_USER=shanutechx_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_root_pass

# Service Keys
PG_META_CRYPTO_KEY=shanutechx_pg_meta_crypto_key_32_chars_min
SECRET_KEY_BASE=shanutechx_secret_key_base_at_least_64_characters_long_for_realtime
REALTIME_DB_ENC_KEY=supabaserealtime

# Gateway & Public URLs
KONG_HTTP_PORT=8001
KONG_HTTPS_PORT=8444
SUPABASE_PUBLIC_URL=http://localhost:8001
API_EXTERNAL_URL=http://localhost:8001/auth/v1
SITE_URL=http://localhost:3001

# Dashboard credentials
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=shanutechx_admin_pass
