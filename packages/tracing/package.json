{
  "name": "@shanutechx/tracing",
  "version": "0.0.0-automated",
  "private": true,
  "description": "Internal W3C/OpenTelemetry trace context propagation utilities for the ShanuTechX JS SDK. Not published — bundled into @shanutechx/supabase-js.",
  "main": "dist/main/index.js",
  "module": "dist/module/index.js",
  "types": "dist/module/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/module/index.js",
      "require": "./dist/main/index.js",
      "types": "./dist/module/index.d.ts"
    }
  },
  "sideEffects": false,
  "scripts": {
    "build": "npm run build:main && npm run build:module",
    "build:main": "tsc -p tsconfig.json",
    "build:module": "tsc -p tsconfig.module.json",
    "test": "jest",
    "test:ci": "jest --coverage"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/supabase/supabase-js.git",
    "directory": "packages/shared/tracing"
  },
  "keywords": [
    "tracing",
    "opentelemetry",
    "w3c",
    "trace-context",
    "distributed-tracing",
    "supabase"
  ],
  "author": "ShanuTechX",
  "files": [
    "dist",
    "src"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/supabase/supabase-js/issues"
  },
  "homepage": "https://github.com/supabase/supabase-js/tree/master/packages/shared/tracing",
  "dependencies": {
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "@opentelemetry/api": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
